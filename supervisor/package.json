{
  "name": "grimport",
  "version": "0.12.0",
  "description": "Grimport — self-hosted static site publishing panel",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test 'test/**/*.test.js'",
    "demo-seed": "DATA_PATH=$PWD/.demo/sites node tools/demo-seed.js",
    "demo-serve": "DATA_PATH=$PWD/.demo/sites HOST_DATA_PATH=$PWD/.demo/sites NODE_ENV=development SUPERVISOR_SECRET=changeme SUPERVISOR_DOMAIN=localhost node src/index.js",
    "screenshots": "node tools/screenshots.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.6.0",
    "dockerode": "^4.0.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.0",
    "multer": "^2.0.0",
    "nanoid": "^5.0.9",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
